FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    TZ=Asia/Kolkata \
    PORT=8000 \
    PYTHONPATH=/app

WORKDIR /app

# Required for pip installs + build tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      curl \
      git \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first for caching, then the vendored SDK source
COPY backend/requirements.txt /tmp/requirements.txt
COPY neo_api_client/ ./neo_api_client/

# The Kotak Neo SDK source is vendored in this repository (neo_api_client/).
# It is copied into the image and resolved via PYTHONPATH=/app — no GitHub tag
# install, no pinned-transitive-version conflicts from the old git+@<tag> pin.
RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install -r /tmp/requirements.txt && \
    python -m pip install --no-cache-dir "websocket-client>=1.8,<2" six python-dateutil

# Copy app code — keep repo layout (/app/backend/...) so `backend.main:app` imports work
COPY backend/ /app/backend/

# Non-root user
RUN useradd --create-home --uid 1001 quantdesk && \
    mkdir -p /app/var && \
    chown -R quantdesk:quantdesk /app

USER quantdesk

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD sh -c 'curl -fsS http://127.0.0.1:${PORT:-8000}/api/v1/system/health || exit 1'

# NOTE: shell form so ${PORT} expands at runtime (Render injects $PORT).
# App lives at backend/main.py -> backend.main:app (there is no `app` package).
CMD python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=*