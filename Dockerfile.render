# AlphaTradePro backend — Render deployment image
# Fixed dependency conflict: fyers-apiv3 installed --no-deps; websockets==8.1 preserved
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    TZ=Asia/Kolkata \
    PORT=8000 \
    PYTHONPATH=/app

WORKDIR /app

# Install build tools before pip install (do NOT purge until very end)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      python3-dev \
      libssl-dev \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY backend/requirements.txt /tmp/requirements.txt

# Step 1: Install base requirements (includes websockets==8.1 and uvicorn==0.13.4)
RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install --no-cache-dir -r /tmp/requirements.txt

# Step 2: Install Fyers API WITHOUT dependencies (so it doesn't pull websockets>=12)
RUN python -m pip install --no-cache-dir --no-deps fyers-apiv3

# Step 3: Install Kotak Neo SDK WITHOUT dependencies (so it doesn't pull conflicting websockets)
RUN python -m pip install --no-cache-dir --no-deps \
    "git+https://github.com/Kotak-Neo/Kotak-neo-api-v2.git@v2.0.2#egg=neo_api_client"

# Step 4: Manually install shared runtime dependencies (compatible with websockets==8.1)
RUN python -m pip install --no-cache-dir \
    "websocket-client>=1.8,<2" \
    "aiohttp" \
    "requests>=2.31.0" \
    six \
    python-dateutil

# Only after ALL pip install succeeds: purge build tools
RUN apt-get purge -y --auto-remove build-essential python3-dev libssl-dev git curl || true
RUN apt-get autoremove -y || true
RUN rm -rf /var/lib/apt/lists/* /tmp/*

# Copy vendored neo_api_client source into image (PYTHONPATH=/app resolves it)
COPY neo_api_client/ ./neo_api_client/

# Copy app code — keep repo layout (/app/backend/...) so `backend.main:app` imports work
COPY backend/ ./backend/

# Non-root user
RUN useradd --create-home --uid 1001 quantdesk && \
    mkdir -p /app/var && \
    chown -R quantdesk:quantdesk /app
USER quantdesk

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD sh -c 'curl -fsS http://127.0.0.1:${PORT:-8000}/api/v1/system/health || exit 1'

# Render start command: shell form so $PORT expands at runtime (Render injects it)
CMD python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=*
