# AlphaTradePro backend
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PIP_NO_CACHE_DIR=1 \
  TZ=Asia/Kolkata

WORKDIR /app

# The Kotak SDK plus the application requirements.
COPY backend/requirements.txt ./backend-requirements.txt
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential curl \
  && pip install -r backend-requirements.txt \
  && pip install "git+https://github.com/Kotak-Neo/Kotak-neo-api-v2.git@v2.0.2#egg=neo_api_client" \
  && apt-get purge -y build-essential \
  && apt-get autoremove -y

COPY backend/ ./backend/

# Run unprivileged.
RUN useradd --create-home --uid 10001 alphatrade \
  && mkdir -p /app/var \
  && chown -R alphatrade:alphatrade /app
USER alphatrade

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/api/v1/system/health || exit 1

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
