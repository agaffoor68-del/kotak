# AlphaTradePro backend — DevOps fix: pin websockets, keep build tools until end,
# install Kotak Neo SDK with --no-deps + manual compatible deps.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PIP_NO_CACHE_DIR=1 \
  PIP_ROOT_USER_ACTION=ignore \
  TZ=Asia/Kolkata \
  PORT=8000

WORKDIR /app

# TASK 2: Ensure git, build-essential, curl are installed.
# Do NOT purge them until the very end (after all Python packages installed).
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     build-essential \
     curl \
     git \
  && rm -rf /var/lib/apt/lists/*

# Cache app requirements layer
COPY backend/requirements.txt ./backend-requirements.txt

# TASK 4 / TASK 1: Install app requirements; pin websockets==8.1 (compatible with Kotak Neo v2)
# Uvicorn[standard]>=0.30 works with websockets>=8.1 (no breakage);
# we explicitly pin to 8.1 to avoid auto-upgrade conflicts with SDK.
RUN pip install --no-cache-dir -v --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -v -r backend-requirements.txt 2>&1 | tee /tmp/pip_install.log || (echo 'PIP FAILED - see /tmp/pip_install.log' && cat /tmp/pip_install.log && exit 1)

# TASK 3: Install Kotak Neo API without dependencies (workaround for ancient exact pins)
RUN pip install --no-deps "git+https://github.com/Kotak-Neo/Kotak-neo-api-v2.git@v2.0.2#egg=neo_api_client"
RUN pip install "websockets==8.1" "websocket-client>=1.8,<2" "requests>=2.32,<3" six python-dateutil

# TASK 2 (manual after --no-deps): install correct versions

# After all Python packages installed: only now purge build tools (TASK 2 rule)
RUN apt-get purge -y --auto-remove build-essential curl git || true
RUN apt-get autoremove -y || true
RUN rm -rf /var/lib/apt/lists/* /tmp/*

COPY backend/ ./backend/

# Unprivileged runtime user
RUN useradd --create-home --uid 10001 alphatrade \
  && mkdir -p /app/var \
  && chown -R alphatrade:alphatrade /app
USER alphatrade

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
