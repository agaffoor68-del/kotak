# AlphaTradePro backend
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PIP_NO_CACHE_DIR=1 \
  PIP_ROOT_USER_ACTION=ignore \
  TZ=Asia/Kolkata \
  PORT=8000

WORKDIR /app

# The Kotak SDK plus the application requirements.
# --no-deps: the SDK pins ancient exact versions (numpy==2.1.0, pandas==2.2.3,
# PyJWT==2.6.0, websockets==8.1, asyncio==3.4.3) that conflict with our ranges.
COPY backend/requirements.txt ./backend-requirements.txt
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential curl git \
  && pip install -r backend-requirements.txt \
  && pip install --no-deps "git+https://github.com/Kotak-Neo/Kotak-neo-api-v2.git@v2.0.2#egg=neo_api_client" \
  && pip install "websocket-client>=1.8,<2" "websockets>=8.1,<16" six python-dateutil \
  && apt-get purge -y build-essential \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

COPY backend/ ./backend/

# Run unprivileged.
RUN useradd --create-home --uid 10001 alphatrade \
  && mkdir -p /app/var \
  && chown -R alphatrade:alphatrade /app
USER alphatrade

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD sh -c 'curl -fsS http://127.0.0.1:${PORT:-8000}/api/v1/system/health || exit 1'

# Render / any container host injects $PORT. Default to 8000 for
# docker-compose / local `docker build` runs.
# NOTE: shell form is intentional so ${PORT} expands at runtime
# (exec JSON form does NOT expand env vars).
CMD python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=*

