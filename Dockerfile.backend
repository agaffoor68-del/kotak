# AlphaTradePro backend — loud build, no suppression, --no-cache-dir everywhere
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PIP_NO_CACHE_DIR=1 \
  PIP_ROOT_USER_ACTION=ignore \
  TZ=Asia/Kolkata \
  PORT=8000 \
  PYTHONPATH=/app

WORKDIR /app

# TASK 3: Build tools before any pip (do NOT purge until very end)
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential curl git && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./backend-requirements.txt

# The SDK source is vendored in this repository. Installing it from GitHub made
# image builds depend on a remote tag and failed before the application was copied.
COPY neo_api_client/ ./neo_api_client/

RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    python -m pip install --no-cache-dir -r backend-requirements.txt && \
    python -m pip install --no-cache-dir "websocket-client>=1.8,<2" six python-dateutil

# Only after ALL pip install succeeds: purge build tools (not before!)
RUN apt-get purge -y --auto-remove build-essential curl git || true
RUN apt-get autoremove -y || true
RUN rm -rf /var/lib/apt/lists/* /tmp/*

COPY backend/ ./backend/

RUN useradd --create-home --uid 10001 alphatrade && \
    mkdir -p /app/var && \
    chown -R alphatrade:alphatrade /app
USER alphatrade

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
