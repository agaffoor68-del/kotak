# AlphaTradePro backend — loud build, no suppression, --no-cache-dir everywhere
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PIP_NO_CACHE_DIR=1 \
  PIP_ROOT_USER_ACTION=ignore \
  TZ=Asia/Kolkata \
  PORT=8000

WORKDIR /app

# TASK 3: Build tools before any pip (do NOT purge until very end)
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential curl git && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./backend-requirements.txt

# TASK 2 + 3: EXACT COMMAND — no tee, no || true, --no-cache-dir on every pip, loud failure
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r backend-requirements.txt && \
    pip install --no-cache-dir --no-deps "git+https://github.com/Kotak-Neo/Kotak-neo-api-v2.git@v2.0.2#egg=neo_api_client" && \
    pip install --no-cache-dir "websockets==8.1" "websocket-client>=1.8,<2" six python-dateutil

# Only after ALL pip install succeeds: purge build tools (not before!)
RUN apt-get purge -y --auto-remove build-essential curl git || true
RUN apt-get autoremove -y || true
RUN rm -rf /var/lib/apt/lists/* /tmp/*

COPY backend/ ./backend/

RUN useradd --create-home --uid 10001 alphatrade && \
    mkdir -p /app/var && \
    chown -R alphatrade:alphatrade /app
USER alphatrade

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
