# AlphaTradePro backend - Render optimized
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PIP_NO_CACHE_DIR=1 \
  TZ=Asia/Kolkata \
  PIP_DEFAULT_TIMEOUT=100

WORKDIR /app

# Install system dependencies first
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  curl \
  git \
  && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/requirements.txt ./backend-requirements.txt

# Install pip packages with retry logic
RUN pip install --upgrade pip setuptools wheel && \
  pip install -r backend-requirements.txt --retries 5 --timeout 100 || true

# Install Kotak SDK with git retry
RUN pip install --upgrade pip && \
  pip install "git+https://github.com/Kotak-Neo/Kotak-neo-api-v2.git@v2.0.2#egg=neo_api_client" \
  --retries 5 --timeout 100 || echo "Kotak SDK install attempt completed"

# Copy application code
COPY backend/ ./backend/

# Create app user
RUN useradd --create-home --uid 10001 alphatrade && \
  mkdir -p /app/var && \
  chown -R alphatrade:alphatrade /app

USER alphatrade

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/api/v1/system/health || exit 1

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
