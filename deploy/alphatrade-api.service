[Unit]
Description=AlphaTradePro API (Kotak Neo market data and execution)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alphatrade
Group=alphatrade
WorkingDirectory=/opt/alphatrade
EnvironmentFile=/opt/alphatrade/.env
Environment=TZ=Asia/Kolkata
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/alphatrade

# A dead API is worse than a slow start: always come back.
Restart=always
RestartSec=10
StartLimitIntervalSec=0

ExecStart=/opt/alphatrade/.venv/bin/python -m uvicorn backend.main:app \
  --host 127.0.0.1 --port 8000 \
  --proxy-headers --forwarded-allow-ips=127.0.0.1

StandardOutput=append:/var/log/alphatrade-api.log
StandardError=append:/var/log/alphatrade-api.log

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alphatrade/var

[Install]
WantedBy=multi-user.target
