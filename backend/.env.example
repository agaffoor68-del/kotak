JWT_SECRET=wNiXoKQ6veZ2lCLCAefb0jDdCK7HmcXiR2HYQYbbV9u8ER-Y4UNdx0O9z11JgH0L
JWT_TTL_MINUTES=720
# First admin created on boot when no users exist.
BOOTSTRAP_ADMIN_EMAIL=agaffoor68@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=Abdul@222
# Optional read-only account.
BOOTSTRAP_VIEWER_EMAIL=
BOOTSTRAP_VIEWER_PASSWORD=

# --- Kotak Neo ---
# Generate a consumer key at: Kotak Neo app -> invest -> trade API card.
KOTAK_CONSUMER_KEY=2304219e-1d0a-4fb0-8cf2-47e8ee1f7f0e
KOTAK_TOTP_KEY=NZ4RACKZ4UHQVY7KRDONQ5KNAE
KOTAK_MOBILE_NUMBER=+918790218191
KOTAK_MPIN=124578
KOTAK_UCC=X7KT4
KOTAK_ENVIRONMENT=prod
KOTAK_LEGACY_ENV_FALLBACK=1
KOTAK_KEEPALIVE=1
KOTAK_KEEPALIVE_SECONDS=300
KOTAK_SESSION_TTL_SECONDS=2700

# IMPORTANT (SEBI): Kotak Neo requires a registered static IP for order APIs.
# Register this host's public IP with Kotak before enabling live orders.
# --- Angel One SmartAPI (MARKET DATA + optional execution) ---
# Angel One is the data layer: instrument master, live quotes and historical
# candles all come from SmartAPI. Kotak Neo is never asked for market data.
# Generate an API key at: Angel One -> SmartAPI (smartapi.angelone.in) -> My Apps.
ANGEL_API_KEY=7Wn5RQCA
ANGEL_CLIENT_CODE=S53557129
ANGEL_PIN=1245
ANGEL_TOTP_KEY=IQFWKQSHBLMPD6SZ5CRBE6IZDI
ANGEL_ENVIRONMENT=prod
ANGEL_SESSION_TTL_SECONDS=28800
# SmartAPI allows ~3 requests/second and caps symbols per quote call.
ANGEL_RATE_LIMIT_PER_SECOND=3
ANGEL_MAX_TOKENS_PER_CALL=50
ANGEL_HISTORY_DAYS_DEFAULT=30
ANGEL_HISTORY_DAYS_MAX=1800

# --- execution routing ---
# Which broker receives an order when the caller does not name one.
# "kotak", "angel" or "both" (fan the same signal out to both brokers).
DEFAULT_EXECUTION_BROKER=kotak
# Brokers this deployment is allowed to route to at all.
EXECUTION_BROKERS=kotak,angel
DUAL_EXECUTION_SIZE=1.0

# --- market data ---
FEED_POLL_SECONDS=1
RECORD_TICKS=1
TICK_RETENTION_DAYS=30
BREADTH_UNIVERSE_SIZE=200
CANDLE_INTERVALS=1m,3m,5m,15m,30m,60m,1d

# --- public URLs ---
PUBLIC_URL=https://kotak-evlz.onrender.com
FRONTEND_URL=https://kotak-jade.vercel.app/
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- deployment: static IP + redirect URL (SEBI compliance) ---
# SEBI requires brokers to see a fixed source IP on order APIs. Attach an
# Elastic IP (AWS) / Reserved IP (DigitalOcean) / static IP (GCP), register it
# on the broker portal, then record it here so the admin panel can warn when
# the host stops egressing from it.
STATIC_IP=
# Set to 1 once the address is a real Elastic/Reserved IP (survives stop/start).
STATIC_IP_RESERVED=0
# Optional: skip the public-IP lookup (air-gapped hosts) by stating it directly.
PUBLIC_IP_OVERRIDE=
PUBLIC_IP_CHECK=1
PUBLIC_IP_CHECK_URL=https://api.ipify.org
PUBLIC_IP_CACHE_SECONDS=300

# OAuth / broker-API redirect. Defaults to PUBLIC_URL + REDIRECT_PATH.
# Production: https://mywebsite.com/callback
# Development: http://127.0.0.1:8000/callback
REDIRECT_PATH=/callback
REDIRECT_URL=https://kotak-evlz.onrender.com
# Extra redirect targets a broker may have been given (comma-separated).
REDIRECT_ALLOWLIST=1
# Reject a redirect that arrives over plain HTTP.
REQUIRE_HTTPS=0

# --- feature gates ---
# Live trading stays off until credentials and risk limits are configured.
ENABLE_LIVE_TRADING=1
ENABLE_PAPER_TRADING=1
ENABLE_BACKTEST=1
ENABLE_ALGO_EXECUTION=1

# --- alerts (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=alphatrade
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@alphatrade.local
SMTP_USE_TLS=1

# --- AI coach (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
