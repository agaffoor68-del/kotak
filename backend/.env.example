# ---------------------------------------------------------------- AlphaTradePro
# Copy to .env and fill in real values. Never commit the filled copy.

ENVIRONMENT=development
DEBUG=0

# --- storage ---
POSTGRES_DSN=postgresql://trader:trader@localhost:5432/alphatrade
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./var

# --- security ---
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=
JWT_SECRET=
JWT_TTL_MINUTES=720
# First admin created on boot when no users exist.
BOOTSTRAP_ADMIN_EMAIL=admin@alphatrade.local
BOOTSTRAP_ADMIN_PASSWORD=
# Optional read-only account.
BOOTSTRAP_VIEWER_EMAIL=
BOOTSTRAP_VIEWER_PASSWORD=

# --- Kotak Neo ---
# Generate a consumer key at: Kotak Neo app -> invest -> trade API card.
KOTAK_CONSUMER_KEY=
KOTAK_TOTP_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_MPIN=
KOTAK_UCC=
KOTAK_ENVIRONMENT=prod
KOTAK_LEGACY_ENV_FALLBACK=1
KOTAK_KEEPALIVE=1
KOTAK_KEEPALIVE_SECONDS=300
KOTAK_SESSION_TTL_SECONDS=2700

# --- market data ---
FEED_POLL_SECONDS=1
RECORD_TICKS=1
TICK_RETENTION_DAYS=30
BREADTH_UNIVERSE_SIZE=200
CANDLE_INTERVALS=1m,3m,5m,15m,30m,60m,1d

# --- public URLs ---
PUBLIC_URL=
FRONTEND_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- feature gates ---
# Live trading stays off until credentials and risk limits are configured.
ENABLE_LIVE_TRADING=0
ENABLE_PAPER_TRADING=1
ENABLE_BACKTEST=1
ENABLE_ALGO_EXECUTION=0

# --- alerts (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=alphatrade
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@alphatrade.local
SMTP_USE_TLS=1

# --- AI coach (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
